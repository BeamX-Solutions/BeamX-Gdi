# Neon pooled connection (the app).
DATABASE_URL=
# Neon direct connection (drizzle-kit migrate only).
DATABASE_URL_UNPOOLED=
# Min 32 chars. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the app. Set it in Production (e.g. https://beamx-gdi.vercel.app) and locally
# (http://localhost:3000). Leave it unset on Vercel Preview: the app then uses VERCEL_URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Set by Vercel on git deploys (the branch alias host). Better Auth trusts it as an origin so
# the branch preview link can sign a guest in. Leave it unset locally.
VERCEL_BRANCH_URL=
# "true" turns on the /design showcase page. Set it when you BUILD (the page is rendered at
# build time). On for local and Preview; leave unset in Production.
ENABLE_DESIGN_PAGE=true
# Claude API key for reports (spec 0005). Without it the app runs, but a report fails.
ANTHROPIC_API_KEY=
# Upstash Redis (eu-central-1): the chat turn lock (spec 0006) and resumable streams
# (spec 0007), later rate limits. Without them the turn lock is off; a Production deploy fails to
# start without both. Set them in Preview too.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Chat limits (spec 0007, AC-8). Typed text over MAX_MESSAGE_CHARS, and the typed
# message after RATE_LIMIT_MESSAGES_PER_RUN in one run, get a friendly notice, no AI call.
MAX_MESSAGE_CHARS=4000
RATE_LIMIT_MESSAGES_PER_RUN=40
# "true" makes every AI call use the scripted fake models (spec 0007). Only `pnpm e2e` sets
# it; a Production deploy refuses to start with it, and it is ignored there anyway.
E2E_FAKE_AI=
