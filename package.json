{
  "name": "beamx-workspace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "test": "vitest run --project unit --passWithNoTests",
    "test:integration": "vitest run --project integration",
    "check:colors": "bash scripts/check-raw-colors.sh",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.1",
    "better-auth": "^1.7.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "drizzle-orm": "~0.45.4",
    "lucide-react": "^1.74.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-resizable-panels": "^4.24.0",
    "streamdown": "^2.7.1",
    "tailwind-merge": "^3.7.0",
    "use-stick-to-bottom": "^1.1.6",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24 <25"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "node node_modules/eslint/bin/eslint.js --fix --max-warnings=0",
      "node node_modules/prettier/bin/prettier.cjs --write"
    ],
    "*.{json,css,md,yml,yaml}": "node node_modules/prettier/bin/prettier.cjs --write"
  }
}
